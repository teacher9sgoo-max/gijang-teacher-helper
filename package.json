{
  "name": "gijang-teacher-helper",
  "version": "1.0.0",
  "description": "기장중학교 교무 도우미 Windows 앱",
  "main": "electron-main.cjs",
  "author": "기장중학교",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "kr.gijang.teacherhelper",
    "productName": "기장중학교 교무 도우미",
    "directories": { "output": "dist" },
    "files": ["index.html", "dashboard-config.js", "manifest.webmanifest", "sw.js", "icons/**/*", "electron-main.cjs", "preload.cjs"],
    "win": { "target": ["nsis", "portable"], "icon": "icons/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "기장중학교 교무 도우미" }
  }
}
